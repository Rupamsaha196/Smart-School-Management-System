APP_NAME="Smart School"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smart-school-backend.onrender.com

# Database — SQLite on Render persistent disk
DB_CONNECTION=sqlite
DB_DATABASE=/var/data/database.sqlite

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Cache / Session
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# CORS — allow your Render frontend domain
CORS_ALLOWED_ORIGINS=https://smart-school-frontend.onrender.com
SANCTUM_STATEFUL_DOMAINS=smart-school-frontend.onrender.com
SESSION_DOMAIN=.onrender.com
